# =====================================================================
# Dify - Dokploy environment template (IP + porta, sem HTTPS)
# =====================================================================
# Modo simples: acesso por http://<IP_DO_SERVIDOR>:<NGINX_HOST_PORT>
# Sem domínio, sem Let's Encrypt. Pra usar HTTPS depois, troque as URLs
# pra https://seu-dominio e adicione o domínio na aba Domains do Dokploy.
#
# Tip: gere segredos com `openssl rand -base64 42`.
# =====================================================================

# ---- Porta que o Dify vai abrir no host ----
# Acesso final: http://<IP_DO_SERVIDOR>:<NGINX_HOST_PORT>
# Troque se 8080 estiver em uso.
NGINX_HOST_PORT=8080

# ---- URLs públicas (TROQUE 76.13.236.75 PELO IP DO SEU SERVIDOR) ----
CONSOLE_API_URL=http://76.13.236.75:8080
CONSOLE_WEB_URL=http://76.13.236.75:8080
SERVICE_API_URL=http://76.13.236.75:8080
APP_API_URL=http://76.13.236.75:8080
APP_WEB_URL=http://76.13.236.75:8080
FILES_URL=http://76.13.236.75:8080
ENDPOINT_URL_TEMPLATE=http://76.13.236.75:8080/e/{hook_id}
TRIGGER_URL=http://76.13.236.75:8080
NEXT_PUBLIC_SOCKET_URL=ws://76.13.236.75:8080
NGINX_SERVER_NAME=_

# ---- CORS ----
WEB_API_CORS_ALLOW_ORIGINS=http://76.13.236.75:8080
CONSOLE_CORS_ALLOW_ORIGINS=http://76.13.236.75:8080

# ---- Bootstrap admin (OBRIGATÓRIO) ----
INIT_PASSWORD=TrocarEssaSenhaForte#2026

# ---- Segredos (TROQUE com `openssl rand -base64 42`) ----
SECRET_KEY=
DB_PASSWORD=CHANGE_ME_db_password
REDIS_PASSWORD=CHANGE_ME_redis_password
SANDBOX_API_KEY=CHANGE_ME_sandbox_api_key
PLUGIN_DAEMON_KEY=CHANGE_ME_plugin_daemon_key
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME_plugin_inner_api_key
WEAVIATE_API_KEY=CHANGE_ME_weaviate_api_key

# ---- Runtime ----
TZ=America/Sao_Paulo
DEPLOY_ENV=PRODUCTION
LOG_LEVEL=INFO

# ---- Escala (ajuste conforme vCPU) ----
SERVER_WORKER_AMOUNT=2
CELERY_WORKER_AMOUNT=2
NGINX_WORKER_PROCESSES=auto
NGINX_CLIENT_MAX_BODY_SIZE=100M

# ---- Marketplace ----
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=https://marketplace.dify.ai

# ---- Telemetria ----
NEXT_TELEMETRY_DISABLED=1
WEAVIATE_DISABLE_TELEMETRY=true

# ---- Mail (opcional) ----
# MAIL_TYPE=smtp
# MAIL_DEFAULT_SEND_FROM=no-reply@exemplo.com
# SMTP_SERVER=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
